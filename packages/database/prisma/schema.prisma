generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =================================================
// BETTER-AUTH MODELS
// =================================================
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// =================================================
// APP MODELS
// =================================================
model Event {
  id           String             @id @default(uuid())
  date         DateTime
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  translations EventTranslation[]
  gallery      EventImage[]

  @@map("events")
}

model EventTranslation {
  id          String  @id @default(uuid())
  eventId     String
  language    String
  title       String?
  description String  @db.Text
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, language])
  @@index([eventId])
  @@map("event_translations")
}

model EventImage {
  id        String @id @default(uuid())
  eventId   String
  imageUrl  String
  sortOrder Int    @default(0)
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_images")
}

model TeamMember {
  id           String                  @id @default(uuid())
  avatarUrl    String
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  translations TeamMemberTranslation[]
  awards       TeamMemberAward[]
  links        TeamMemberLink[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@map("team_members")
}

model TeamMemberTranslation {
  id       String     @id @default(uuid())
  memberId String
  language String
  name     String
  role     String
  bio      String     @db.Text
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, language])
  @@index([memberId])
  @@map("team_member_translations")
}

model TeamMemberAward {
  id       String     @id @default(uuid())
  memberId String
  imageUrl String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("team_member_awards")
}

model TeamMemberLink {
  id           String                      @id @default(uuid())
  memberId     String
  url          String
  member       TeamMember                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  translations TeamMemberLinkTranslation[]

  @@index([memberId])
  @@map("team_member_links")
}

model TeamMemberLinkTranslation {
  id       String         @id @default(uuid())
  linkId   String
  language String
  label    String
  link     TeamMemberLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, language])
  @@index([linkId])
  @@map("team_member_link_translations")
}

model Partner {
  id           String               @id @default(uuid())
  isActive     Boolean              @default(true)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations PartnerTranslation[]
  gallery      PartnerImage[]
  links        PartnerLink[]

  @@map("partners")
}

model PartnerTranslation {
  id          String  @id @default(uuid())
  partnerId   String
  language    String
  name        String
  description String  @db.Text
  partner     Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, language])
  @@index([partnerId])
  @@map("partner_translations")
}

model PartnerImage {
  id        String  @id @default(uuid())
  partnerId String
  imageUrl  String
  sortOrder Int     @default(0)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_images")
}

model PartnerLink {
  id           String                   @id @default(uuid())
  partnerId    String
  url          String
  partner      Partner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  translations PartnerLinkTranslation[]

  @@index([partnerId])
  @@map("partner_links")
}

model PartnerLinkTranslation {
  id       String      @id @default(uuid())
  linkId   String
  language String
  label    String
  link     PartnerLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, language])
  @@index([linkId])
  @@map("partner_link_translations")
}

model CharityProject {
  id           String                      @id @default(uuid())
  date         DateTime
  isActive     Boolean                     @default(true)
  sortOrder    Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  translations CharityProjectTranslation[]
  gallery      CharityProjectImage[]

  @@map("charity_projects")
}

model CharityProjectTranslation {
  id          String         @id @default(uuid())
  projectId   String
  language    String
  title       String?
  period      String?
  description String         @db.Text
  project     CharityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, language])
  @@index([projectId])
  @@map("charity_project_translations")
}

model CharityProjectImage {
  id        String         @id @default(uuid())
  projectId String
  imageUrl  String
  sortOrder Int            @default(0)
  project   CharityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("charity_project_images")
}

enum ShowcaseCategory {
  CONCERT           // Концертные программы
  ARTIST            // Артисты
  PERFORMANCE       // Спектакли
  MASTER_CLASS      // Мастер-классы
  HOLIDAY_EVENT     // Новогодние представления
  EXHIBITION        // Выставки
}

model Showcase {
  id           String                @id @default(uuid())
  category     ShowcaseCategory
  videoUrl     String?
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  translations ShowcaseTranslation[]
  gallery      ShowcaseImage[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("showcases")
}

model ShowcaseTranslation {
  id          String   @id @default(uuid())
  showcaseId  String
  language    String
  title       String
  subtitle    String?
  description String   @db.Text
  showcase    Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  @@unique([showcaseId, language])
  @@index([showcaseId])
  @@map("showcase_translations")
}

model ShowcaseImage {
  id         String   @id @default(uuid())
  showcaseId String
  imageUrl   String
  sortOrder  Int      @default(0)
  showcase   Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  @@index([showcaseId])
  @@map("showcase_images")
}

model Festival {
  id           String                @id @default(uuid())
  logoUrl      String
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  translations FestivalTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("festivals")
}

model FestivalTranslation {
  id         String   @id @default(uuid())
  festivalId String
  language   String
  title      String
  subtitle   String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@unique([festivalId, language])
  @@index([festivalId])
  @@map("festival_translations")
}

model GlobalAward {
  id        String   @id @default(uuid())
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("global_awards")
}

model PlayCastMember {
  id           String                      @id @default(uuid())
  avatarUrl    String?
  sortOrder    Int                         @default(0)
  translations PlayCastMemberTranslation[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@map("play_cast_members")
}

model PlayCastMemberTranslation {
  id        String         @id @default(uuid())
  memberId  String
  language  String
  actorName String
  role      String
  bio       String         @db.Text
  member    PlayCastMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, language])
  @@index([memberId])
  @@map("play_cast_member_translations")
}

enum UstaMediaType {
  VIDEO
  IMAGE
  AWARD
}

model UstaMedia {
  id        String        @id @default(uuid())
  type      UstaMediaType
  url       String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("usta_media")
}

enum RentalCategory {
  PROP         // Аренда реквизита
  ATTRACTION   // Аренда аттракционов
  MASCOT       // Аренда Ростовых Кукол
}

model RentalItem {
  id           String                  @id @default(uuid())
  category     RentalCategory
  imageUrl     String
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations RentalItemTranslation[]

  @@map("rental_items")
}

model RentalItemTranslation {
  id          String     @id @default(uuid())
  itemId      String
  language    String
  title       String
  description String?    @db.Text
  item        RentalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, language])
  @@index([itemId])
  @@map("rental_item_translations")
}
