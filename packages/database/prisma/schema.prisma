generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ru
  en
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model CharityContent {
  id           String                      @id @default(uuid())
  images       String[]                    @default([])
  videos       String[]                    @default([])
  translations CharityContentTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CharityContentTranslation {
  id               String  @id @default(uuid())
  charityContentId String
  locale           Locale
  title            String
  text             String?

  charityContent CharityContent @relation(fields: [charityContentId], references: [id], onDelete: Cascade)

  @@unique([charityContentId, locale])
  @@index([locale])
  @@index([charityContentId])
}

