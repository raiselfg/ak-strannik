generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Better Auth
// ============================================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ============================================================
// Enums
// ============================================================

enum Locale {
  ru
  en
}

enum ContentStatus {
  draft
  published
  archived
}

enum RentalType {
  mascot
  attraction
  props
}

enum ProjectType {
  musical
  singer
  exhibition
  newYearShow
  masterClass
  performance
  artist
  concertProgram
  festival
  charity
  other
}

enum ProjectSectionVariant {
  content
  split
  gallery
  slider
  video
  quote
}

enum VideoProvider {
  youtube
  vk
  rutube
  external
}

// ============================================================
// Media
// ============================================================

model MediaAsset {
  id        String @id @default(uuid()) @db.Uuid
  objectKey String @unique

  // Используется для дедупликации при миграции и загрузке.
  // Поле nullable, чтобы безопасно мигрировать существующие записи.
  checksumSha256 String? @unique

  originalName String
  mimeType     String
  size         Int?
  width        Int?
  height       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations MediaAssetTranslation[]

  teamMembers TeamMember[] @relation("TeamMemberImage")

  eventCovers Event[]      @relation("EventCoverImage")
  eventImages EventImage[] @relation("EventGalleryImage")

  rentalItemCovers RentalItem[]      @relation("RentalItemCoverImage")
  rentalItemImages RentalItemImage[] @relation("RentalItemGalleryImage")

  projectCovers       Project[]             @relation("ProjectCoverImage")
  projectSectionMedia ProjectSectionMedia[] @relation("ProjectSectionMediaAsset")

  partnerLogos Partner[]      @relation("PartnerLogo")
  partnerMedia PartnerMedia[] @relation("PartnerPortfolioMedia")

  certificateImages Certificate[] @relation("CertificateImage")

  @@index([mimeType])
  @@index([createdAt])
}

model MediaAssetTranslation {
  id           String @id @default(uuid()) @db.Uuid
  mediaAssetId String @db.Uuid
  locale       Locale

  alt     String?
  title   String?
  caption String? @db.Text

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, locale])
  @@index([locale])
}

// ============================================================
// Team
//
// Используется для блока команды на главной.
// Персональные страницы команды в текущую архитектуру не входят.
// ============================================================

model TeamMember {
  id      String  @id @default(uuid()) @db.Uuid
  imageId String? @db.Uuid

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image MediaAsset? @relation("TeamMemberImage", fields: [imageId], references: [id], onDelete: Restrict)

  translations TeamMemberTranslation[]

  @@index([imageId])
  @@index([isActive, sortOrder])
}

model TeamMemberTranslation {
  id           String @id @default(uuid()) @db.Uuid
  teamMemberId String @db.Uuid
  locale       Locale

  name        String
  role        String?
  description String? @db.Text

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, locale])
  @@index([locale])
}

// ============================================================
// Events
//
// Каждое смысловое мероприятие — отдельная запись.
// Страница архива по годам формируется автоматически.
//
// Формат страницы:
// cover + title + dates + location + body + videos + gallery.
// ============================================================

model Event {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique

  status ContentStatus @default(draft)

  // Используется для группировки архива.
  // Nullable для безопасной миграции старых черновиков.
  // Для published-записей валидируется на уровне приложения.
  eventYear Int?

  // Точные даты, если они известны.
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  // Событие может относиться к постоянному проекту:
  // благотворительной программе, фестивалю, новогоднему проекту.
  projectId String? @db.Uuid

  coverImageId String? @db.Uuid

  sortOrder Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  coverImage MediaAsset? @relation("EventCoverImage", fields: [coverImageId], references: [id], onDelete: Restrict)

  translations EventTranslation[]
  images       EventImage[]
  videos       EventVideo[]

  @@index([status, eventYear, startDate])
  @@index([projectId])
  @@index([sortOrder])
  @@index([coverImageId])
}

model EventTranslation {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  locale  Locale

  title   String
  excerpt String? @db.Text

  // Хранится как Markdown.
  body String? @db.Text

  // Используется для неточной или редакционной даты:
  // "Зимой 2024–2025 годов", "В мае 2025 года".
  dateText String?

  // Площадка, город либо произвольное описание места.
  locationText String?

  seoTitle       String?
  seoDescription String? @db.Text

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, locale])
  @@index([locale])
}

model EventImage {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  mediaId String @db.Uuid

  sortOrder Int @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  media MediaAsset @relation("EventGalleryImage", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([eventId, mediaId])
  @@index([eventId, sortOrder])
  @@index([mediaId])
}

model EventVideo {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid

  provider VideoProvider
  url      String

  sortOrder Int @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, url])
  @@index([eventId, sortOrder])
}

// ============================================================
// Rental
//
// Категории фиксированы.
// У позиции есть основная обложка и необязательная галерея.
// ============================================================

model RentalItem {
  id   String     @id @default(uuid()) @db.Uuid
  slug String     @unique
  type RentalType

  imageId String? @db.Uuid

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image MediaAsset? @relation("RentalItemCoverImage", fields: [imageId], references: [id], onDelete: Restrict)

  translations RentalItemTranslation[]
  images       RentalItemImage[]

  @@index([type, isActive, sortOrder])
  @@index([imageId])
}

model RentalItemTranslation {
  id           String @id @default(uuid()) @db.Uuid
  rentalItemId String @db.Uuid
  locale       Locale

  title       String
  description String? @db.Text
  priceText   String?

  rentalItem RentalItem @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  @@unique([rentalItemId, locale])
  @@index([locale])
}

model RentalItemImage {
  id           String @id @default(uuid()) @db.Uuid
  rentalItemId String @db.Uuid
  mediaId      String @db.Uuid

  sortOrder Int @default(0)

  rentalItem RentalItem @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)

  media MediaAsset @relation("RentalItemGalleryImage", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([rentalItemId, mediaId])
  @@index([rentalItemId, sortOrder])
  @@index([mediaId])
}

// ============================================================
// Projects
//
// Сюда входят спектакли, выставки, мастер-классы,
// концертные программы, фестивали, благотворительные
// и новогодние проекты.
//
// Страница проекта собирается из управляемых секций.
// ============================================================

model Project {
  id   String      @id @default(uuid()) @db.Uuid
  slug String      @unique
  type ProjectType

  status ContentStatus @default(draft)

  coverImageId String? @db.Uuid
  sortOrder    Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  coverImage MediaAsset? @relation("ProjectCoverImage", fields: [coverImageId], references: [id], onDelete: Restrict)

  translations ProjectTranslation[]
  sections     ProjectSection[]
  events       Event[]

  @@index([type, status, sortOrder])
  @@index([coverImageId])
}

model ProjectTranslation {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @db.Uuid
  locale    Locale

  title          String
  subtitle       String?
  excerpt        String? @db.Text
  seoTitle       String?
  seoDescription String? @db.Text

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectSection {
  id        String                @id @default(uuid()) @db.Uuid
  projectId String                @db.Uuid
  variant   ProjectSectionVariant @default(content)

  // Используются только для variant = video.
  videoProvider VideoProvider?
  videoUrl      String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  translations ProjectSectionTranslation[]
  media        ProjectSectionMedia[]

  @@index([projectId, sortOrder])
  @@index([variant])
}

model ProjectSectionTranslation {
  id        String @id @default(uuid()) @db.Uuid
  sectionId String @db.Uuid
  locale    Locale

  title    String?
  subtitle String?

  // Хранится как Markdown.
  body String? @db.Text

  // Используется для variant = quote.
  author String?

  section ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@index([locale])
}

model ProjectSectionMedia {
  id        String @id @default(uuid()) @db.Uuid
  sectionId String @db.Uuid
  mediaId   String @db.Uuid

  sortOrder Int @default(0)

  section ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  media MediaAsset @relation("ProjectSectionMediaAsset", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([sectionId, mediaId])
  @@index([sectionId, sortOrder])
  @@index([mediaId])
}

// ============================================================
// Partners
//
// Основная карточка:
// logo + name + description + website.
//
// Старое портфолио сохраняется отдельно как media/videos.
// Новый landing может показывать только компактные карточки.
// ============================================================

model Partner {
  id     String  @id @default(uuid()) @db.Uuid
  logoId String? @db.Uuid

  websiteUrl String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logo MediaAsset? @relation("PartnerLogo", fields: [logoId], references: [id], onDelete: Restrict)

  translations PartnerTranslation[]
  media        PartnerMedia[]
  videos       PartnerVideo[]

  @@index([logoId])
  @@index([isActive, sortOrder])
}

model PartnerTranslation {
  id        String @id @default(uuid()) @db.Uuid
  partnerId String @db.Uuid
  locale    Locale

  name        String
  description String? @db.Text

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, locale])
  @@index([locale])
}

model PartnerMedia {
  id        String @id @default(uuid()) @db.Uuid
  partnerId String @db.Uuid
  mediaId   String @db.Uuid

  sortOrder Int @default(0)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  media MediaAsset @relation("PartnerPortfolioMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([partnerId, mediaId])
  @@index([partnerId, sortOrder])
  @@index([mediaId])
}

model PartnerVideo {
  id        String @id @default(uuid()) @db.Uuid
  partnerId String @db.Uuid

  provider VideoProvider
  url      String

  sortOrder Int @default(0)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, url])
  @@index([partnerId, sortOrder])
}

// ============================================================
// Certificates / благодарственные письма
// ============================================================

model Certificate {
  id      String @id @default(uuid()) @db.Uuid
  imageId String @db.Uuid

  year      Int?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image MediaAsset @relation("CertificateImage", fields: [imageId], references: [id], onDelete: Restrict)

  translations CertificateTranslation[]

  @@index([imageId])
  @@index([isActive, sortOrder])
  @@index([year])
}

model CertificateTranslation {
  id            String @id @default(uuid()) @db.Uuid
  certificateId String @db.Uuid
  locale        Locale

  title       String?
  issuer      String?
  description String? @db.Text

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, locale])
  @@index([locale])
}
