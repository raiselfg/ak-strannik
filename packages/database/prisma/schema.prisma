generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum EntityStatus {
  active
  archived
}

enum TranslationStatus {
  draft
  review
  published
  archived
}

enum MediaKind {
  image
  video
  document
}

enum MediaStatus {
  pending
  processing
  ready
  failed
  deleting
  deleted
}

enum ProjectKind {
  charity
  showcase
  festival
}

enum ShowcaseCategory {
  concert
  artist
  performance
  master_class
  holiday_event
  exhibition
}

enum RentalCategory {
  prop
  attraction
  mascot
}

enum MetricQualifier {
  exact
  at_least
  at_most
}

enum JobStatus {
  queued
  running
  done
  failed
}

model Locale {
  code       String   @id @db.VarChar(16)
  name       String   @db.Text
  nativeName String   @map("native_name") @db.Text
  pathPrefix String   @default("") @map("path_prefix") @db.VarChar(32)
  isDefault  Boolean  @default(false) @map("is_default")
  isEnabled  Boolean  @default(true) @map("is_enabled")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([pathPrefix])
  @@index([isEnabled, sortOrder])
  @@map("locales")
}

model AuditLog {
  id                  BigInt   @id @default(autoincrement())
  actorAdminAccountId String?  @map("actor_admin_account_id") @db.Uuid
  sessionId           String?  @map("session_id") @db.Uuid
  action              String   @db.Text
  entityType          String?  @map("entity_type") @db.Text
  entityId            String?  @map("entity_id") @db.Uuid
  ipAddress           String?  @map("ip_address")
  userAgent           String?  @map("user_agent") @db.Text
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorAdminAccountId])
  @@index([sessionId])
  @@map("audit_log")
}

model MediaAsset {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                     MediaKind
  bucket                   String      @db.Text
  objectKey                String      @map("object_key") @db.Text
  originalFilename         String?     @map("original_filename") @db.Text
  contentType              String      @map("content_type") @db.Text
  sizeBytes                BigInt      @map("size_bytes")
  width                    Int?
  height                   Int?
  checksumSha256           String?     @map("checksum_sha256") @db.Text
  status                   MediaStatus @default(pending)
  uploadedByAdminAccountId String?     @map("uploaded_by_admin_account_id") @db.Uuid
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations MediaAssetTranslation[]
  variants     MediaVariant[]

  @@unique([bucket, objectKey])
  @@index([uploadedByAdminAccountId])
  @@index([status, createdAt])
  @@map("media_assets")
}

model MediaVariant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  code         String   @db.Text
  bucket       String   @db.Text
  objectKey    String   @map("object_key") @db.Text
  contentType  String   @map("content_type") @db.Text
  sizeBytes    BigInt   @map("size_bytes")
  width        Int?
  height       Int?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, code])
  @@unique([bucket, objectKey])
  @@index([mediaAssetId])
  @@map("media_variants")
}

model MediaAssetTranslation {
  mediaAssetId  String  @map("media_asset_id") @db.Uuid
  localeCode    String  @map("locale_code") @db.VarChar(16)
  altText       String? @map("alt_text") @db.Text
  title         String? @db.Text
  caption       String? @db.Text
  copyrightText String? @map("copyright_text") @db.Text

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([mediaAssetId, localeCode])
  @@index([localeCode])
  @@map("media_asset_translations")
}

model ContentDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  blocks ContentBlock[]

  @@map("content_documents")
}

model ContentBlock {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  type       String   @db.VarChar(32)
  sortOrder  Int      @default(0) @map("sort_order")
  settings   Json
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document ContentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, sortOrder])
  @@map("content_blocks")
}

model Page {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String       @unique @db.VarChar(64)
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations PageTranslation[]

  @@index([status])
  @@map("pages")
}

model PageTranslation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId         String            @map("page_id") @db.Uuid
  localeCode     String            @map("locale_code") @db.VarChar(16)
  title          String?           @db.Text
  slug           String?           @db.VarChar(180)
  bodyDocumentId String?           @map("body_document_id") @db.Uuid
  seoTitle       String?           @map("seo_title") @db.Text
  seoDescription String?           @map("seo_description") @db.Text
  seoOgMediaId   String?           @map("seo_og_media_id") @db.Uuid
  status         TranslationStatus @default(draft)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, localeCode])
  @@index([localeCode, status, publishedAt])
  @@index([bodyDocumentId])
  @@index([seoOgMediaId])
  @@map("page_translations")
}

model Person {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  avatarMediaId String?      @map("avatar_media_id") @db.Uuid
  status        EntityStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations    PersonTranslation[]
  teamMembership  TeamMembership?
  links           PersonLink[]
  awards          PersonAward[]

  @@index([avatarMediaId])
  @@index([status])
  @@map("people")
}

model PersonTranslation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId       String            @map("person_id") @db.Uuid
  localeCode     String            @map("locale_code") @db.VarChar(16)
  fullName       String            @map("full_name") @db.Text
  slug           String?           @db.VarChar(180)
  shortBio       String?           @map("short_bio") @db.Text
  bodyDocumentId String?           @map("body_document_id") @db.Uuid
  seoTitle       String?           @map("seo_title") @db.Text
  seoDescription String?           @map("seo_description") @db.Text
  status         TranslationStatus @default(draft)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, localeCode])
  @@index([localeCode, status, publishedAt])
  @@index([bodyDocumentId])
  @@map("person_translations")
}

model TeamMembership {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId  String       @unique @map("person_id") @db.Uuid
  status    EntityStatus @default(active)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person       Person                      @relation(fields: [personId], references: [id], onDelete: Cascade)
  translations TeamMembershipTranslation[]

  @@index([status, sortOrder])
  @@map("team_memberships")
}

model TeamMembershipTranslation {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamMembershipId String            @map("team_membership_id") @db.Uuid
  localeCode       String            @map("locale_code") @db.VarChar(16)
  roleTitle        String?           @map("role_title") @db.Text
  status           TranslationStatus @default(draft)
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(6)

  membership TeamMembership @relation(fields: [teamMembershipId], references: [id], onDelete: Cascade)

  @@unique([teamMembershipId, localeCode])
  @@index([localeCode, status])
  @@map("team_membership_translations")
}

model PersonLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  url       String   @db.Text
  linkType  String   @map("link_type") @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person       Person                  @relation(fields: [personId], references: [id], onDelete: Cascade)
  translations PersonLinkTranslation[]

  @@index([personId, sortOrder])
  @@map("person_links")
}

model PersonLinkTranslation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personLinkId String  @map("person_link_id") @db.Uuid
  localeCode   String  @map("locale_code") @db.VarChar(16)
  label        String? @db.Text

  link PersonLink @relation(fields: [personLinkId], references: [id], onDelete: Cascade)

  @@unique([personLinkId, localeCode])
  @@index([localeCode])
  @@map("person_link_translations")
}

model PersonAward {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId     String    @map("person_id") @db.Uuid
  imageMediaId String?   @map("image_media_id") @db.Uuid
  awardedOn    DateTime? @map("awarded_on") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person       Person                   @relation(fields: [personId], references: [id], onDelete: Cascade)
  translations PersonAwardTranslation[]

  @@index([personId, sortOrder])
  @@index([imageMediaId])
  @@map("person_awards")
}

model PersonAwardTranslation {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personAwardId String  @map("person_award_id") @db.Uuid
  localeCode    String  @map("locale_code") @db.VarChar(16)
  title         String? @db.Text
  description   String? @db.Text

  award PersonAward @relation(fields: [personAwardId], references: [id], onDelete: Cascade)

  @@unique([personAwardId, localeCode])
  @@index([localeCode])
  @@map("person_award_translations")
}

model Partner {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  logoMediaId String?      @map("logo_media_id") @db.Uuid
  websiteUrl  String?      @map("website_url") @db.Text
  status      EntityStatus @default(active)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations PartnerTranslation[]
  projects     ProjectPartner[]

  @@index([status, sortOrder])
  @@index([logoMediaId])
  @@map("partners")
}

model PartnerTranslation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String            @map("partner_id") @db.Uuid
  localeCode  String            @map("locale_code") @db.VarChar(16)
  name        String            @db.Text
  description String?           @db.Text
  status      TranslationStatus @default(draft)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, localeCode])
  @@index([localeCode, status, publishedAt])
  @@map("partner_translations")
}

model Project {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             ProjectKind
  showcaseCategory ShowcaseCategory? @map("showcase_category")
  startsOn         DateTime?         @map("starts_on") @db.Date
  endsOn           DateTime?         @map("ends_on") @db.Date
  coverMediaId     String?           @map("cover_media_id") @db.Uuid
  status           EntityStatus      @default(active)
  sortOrder        Int               @default(0) @map("sort_order")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations ProjectTranslation[]
  media        ProjectMedia[]
  partners     ProjectPartner[]
  cast         ProjectCastMember[]

  @@index([kind, status, sortOrder])
  @@index([startsOn, endsOn])
  @@index([coverMediaId])
  @@map("projects")
}

model ProjectTranslation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  localeCode     String            @map("locale_code") @db.VarChar(16)
  title          String            @db.Text
  slug           String?           @db.VarChar(180)
  subtitle       String?           @db.Text
  excerpt        String?           @db.Text
  periodLabel    String?           @map("period_label") @db.Text
  bodyDocumentId String?           @map("body_document_id") @db.Uuid
  seoTitle       String?           @map("seo_title") @db.Text
  seoDescription String?           @map("seo_description") @db.Text
  seoOgMediaId   String?           @map("seo_og_media_id") @db.Uuid
  status         TranslationStatus @default(draft)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, localeCode])
  @@index([localeCode, status, publishedAt])
  @@index([bodyDocumentId])
  @@index([seoOgMediaId])
  @@map("project_translations")
}

model ProjectMedia {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String @map("project_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  role         String @default("gallery") @db.VarChar(32)
  sortOrder    Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaAssetId])
  @@index([projectId, sortOrder])
  @@index([mediaAssetId])
  @@map("project_media")
}

model ProjectPartner {
  projectId String @map("project_id") @db.Uuid
  partnerId String @map("partner_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@id([projectId, partnerId])
  @@index([partnerId])
  @@index([projectId, sortOrder])
  @@map("project_partners")
}

model ProjectCastMember {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  personId  String @map("person_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  project      Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  translations ProjectCastMemberTranslation[]

  @@unique([projectId, personId])
  @@index([projectId, sortOrder])
  @@index([personId])
  @@map("project_cast_members")
}

model ProjectCastMemberTranslation {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  castMemberId String  @map("cast_member_id") @db.Uuid
  localeCode   String  @map("locale_code") @db.VarChar(16)
  roleTitle    String? @map("role_title") @db.Text
  note         String? @db.Text

  castMember ProjectCastMember @relation(fields: [castMemberId], references: [id], onDelete: Cascade)

  @@unique([castMemberId, localeCode])
  @@index([localeCode])
  @@map("project_cast_member_translations")
}

model Event {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startsAt     DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?    @map("ends_at") @db.Timestamptz(6)
  timezone     String       @db.Text
  isAllDay     Boolean      @default(false) @map("is_all_day")
  coverMediaId String?      @map("cover_media_id") @db.Uuid
  status       EntityStatus @default(active)
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations EventTranslation[]
  media        EventMedia[]

  @@index([status, startsAt, sortOrder])
  @@index([coverMediaId])
  @@map("events")
}

model EventTranslation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  localeCode     String            @map("locale_code") @db.VarChar(16)
  title          String?           @db.Text
  slug           String?           @db.VarChar(180)
  excerpt        String?           @db.Text
  bodyDocumentId String?           @map("body_document_id") @db.Uuid
  seoTitle       String?           @map("seo_title") @db.Text
  seoDescription String?           @map("seo_description") @db.Text
  seoOgMediaId   String?           @map("seo_og_media_id") @db.Uuid
  status         TranslationStatus @default(draft)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, localeCode])
  @@index([localeCode, status, publishedAt])
  @@index([bodyDocumentId])
  @@index([seoOgMediaId])
  @@map("event_translations")
}

model EventMedia {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String @map("event_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  role         String @default("gallery") @db.VarChar(32)
  sortOrder    Int    @default(0) @map("sort_order")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, mediaAssetId])
  @@index([eventId, sortOrder])
  @@index([mediaAssetId])
  @@map("event_media")
}

model Document {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  String       @db.Text
  issuedAt  DateTime?    @map("issued_at") @db.Date
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations DocumentTranslation[]

  @@index([category, status, issuedAt])
  @@map("documents")
}

model DocumentTranslation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String            @map("document_id") @db.Uuid
  localeCode  String            @map("locale_code") @db.VarChar(16)
  title       String            @db.Text
  slug        String?           @db.VarChar(180)
  description String?           @db.Text
  fileMediaId String?           @map("file_media_id") @db.Uuid
  status      TranslationStatus @default(draft)
  publishedAt DateTime?         @map("published_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, localeCode])
  @@index([localeCode, status, publishedAt])
  @@index([fileMediaId])
  @@map("document_translations")
}

model Report {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String?      @map("project_id") @db.Uuid
  year         Int?         @db.SmallInt
  periodStart  DateTime?    @map("period_start") @db.Date
  periodEnd    DateTime?    @map("period_end") @db.Date
  coverMediaId String?      @map("cover_media_id") @db.Uuid
  status       EntityStatus @default(active)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations ReportTranslation[]
  metrics      ReportMetric[]
  venues       ReportVenue[]

  @@index([status, year])
  @@index([projectId])
  @@index([coverMediaId])
  @@map("reports")
}

model ReportTranslation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId       String            @map("report_id") @db.Uuid
  localeCode     String            @map("locale_code") @db.VarChar(16)
  title          String            @db.Text
  slug           String?           @db.VarChar(180)
  excerpt        String?           @db.Text
  bodyDocumentId String?           @map("body_document_id") @db.Uuid
  seoTitle       String?           @map("seo_title") @db.Text
  seoDescription String?           @map("seo_description") @db.Text
  status         TranslationStatus @default(draft)
  publishedAt    DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, localeCode])
