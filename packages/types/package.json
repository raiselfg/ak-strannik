{
  "name": "@ak-strannik/types",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ak-strannik/eslint-config": "workspace:*",
    "@ak-strannik/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5"
  }
}
